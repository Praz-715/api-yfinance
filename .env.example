# ---------------------------------------------------------------------------
# Environment configuration. Copy to `.env` for local development.
# NEVER commit a real `.env`. In production set these in the Vercel dashboard.
# ---------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security (REQUIRED in production) -------------------------------------
# Comma-separated API keys. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Keep two keys live during rotation, then remove the retired one.
API_KEYS=

# JWT signing secret. MUST be >= 32 chars in production.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=teguh-prasetyo.com
JWT_AUDIENCE=teguh-prasetyo.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400

# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=https://teguh-prasetyo.com,https://www.teguh-prasetyo.com

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_HEAVY=10/minute
RATE_LIMIT_AUTH=20/minute

# --- Cache / Redis (optional; in-memory fallback when unset) ---------------
# Example: redis://default:password@host:6379/0  (Upstash/Vercel KV compatible)
REDIS_URL=
CACHE_DEFAULT_TTL_SECONDS=30
QUOTE_CACHE_TTL_SECONDS=15
HISTORY_CACHE_TTL_SECONDS=300
MARKET_CACHE_TTL_SECONDS=60

# --- Providers --------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=8.0
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.4
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30.0
MARKET_UNIVERSE_CONCURRENCY=8

# --- Limits -----------------------------------------------------------------
MAX_BODY_BYTES=16384
MAX_HISTORY_ROWS=5000
REQUEST_TIMEOUT_SECONDS=20.0

# --- Bot protection ---------------------------------------------------------
BLOCKED_USER_AGENTS=sqlmap,nikto,nessus,masscan,zgrab,nmap,dirbuster,wpscan,acunetix,nuclei
